{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/editor",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "/editor",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/post/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|Googlebot|bingbot|Applebot|redditbot|Embedly|Quora Link Preview|vkShare|SkypeUriPreview|Iframely|Mastodon)"
        }
      ],
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/github-cms",
      "destination": "/admin/index.html"
    },
    {
      "source": "/account",
      "destination": "/account/index.html"
    },
    {
      "source": "/editor",
      "destination": "/editor/index.html"
    },
    {
      "source": "/register",
      "destination": "/account/index.html?view=register"
    },
    {
      "source": "/login",
      "destination": "/account/index.html?view=login"
    },
    {
      "source": "/post/:id",
      "destination": "/"
    },
    {
      "source": "/search",
      "destination": "/"
    },
    {
      "source": "/national",
